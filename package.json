{
  "name": "seoforge",
  "version": "2.0.0",
  "description": "Screaming Frog-grade local SEO crawler + Ahrefs-grade audit engine + AEO scoring + web dashboard + MCP agent server.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "seoforge": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "crawl": "tsx src/cli.ts crawl",
    "audit": "tsx src/cli.ts audit",
    "indexnow": "tsx src/cli.ts indexnow",
    "report": "tsx src/cli.ts report",
    "daily": "tsx src/cli.ts daily",
    "serve": "tsx src/cli.ts serve",
    "mcp": "tsx src/cli.ts mcp",
    "build:engine": "tsc",
    "build:web": "vite build",
    "build": "npm run build:engine && npm run build:web",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p web.tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "seo",
    "aeo",
    "answer-engine-optimization",
    "crawler",
    "site-audit",
    "screaming-frog",
    "ahrefs",
    "indexnow",
    "schema-org",
    "ai-search",
    "perplexity",
    "google-search-essentials",
    "bing-webmaster",
    "mcp",
    "autonomous-agent"
  ],
  "author": "Aryan Bansal <https://www.webforge.me/>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aryanban/seoforge.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.0.0",
    "colorette": "^2.0.20",
    "commander": "^13.1.0",
    "fast-xml-parser": "^5.0.8",
    "hono": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.0"
  },
  "optionalDependencies": {
    "open": "^10.1.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  }
}
